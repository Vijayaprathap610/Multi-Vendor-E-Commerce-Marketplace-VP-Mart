# ── VP Mart Frontend Environment Variables ──────────────────────────────────
# Configure these in your Netlify Dashboard (Site settings → Environment variables)

# Production API Base URL:
# Set to your deployed Render backend URL + /api (e.g. https://vp-mart-backend.onrender.com/api)
# In local development: Leave empty so Vite dev server proxies '/api' to localhost:5000
VITE_API_URL=

# Socket.io Server URL:
# Set to your deployed Render backend root URL (e.g. https://vp-mart-backend.onrender.com)
# If omitted in production, it will automatically derive from VITE_API_URL
VITE_SOCKET_URL=

# Local dev proxy target (only used by Vite dev server, defaults to http://localhost:5000)
# VITE_DEV_API=http://localhost:5000
