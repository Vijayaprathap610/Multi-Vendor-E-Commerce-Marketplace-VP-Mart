{
  "name": "vp-mart-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 \"tests/*.test.js\"",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "audit": "npm audit --omit=dev",
    "seed:catalog": "node src/scripts/seedCatalog.js",
    "seed:demo": "node src/scripts/seedDemo.js",
    "import:fakestore": "node src/scripts/importFakeStore.js",
    "search:reindex": "node src/scripts/reindexSearch.js",
    "media:cleanup": "node src/scripts/cleanupMedia.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@elastic/elasticsearch": "^9.5.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
