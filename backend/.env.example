# ── VP Mart Backend Environment Variables ──────────────────────────────────
# In Production (Render): Configure these in your Render Web Service Dashboard (Environment tab)
# In Local Development: Copy to .env and adjust values as needed. NEVER commit .env.

# Server Environment & Port
# Render automatically sets PORT (defaults to 10000 on Render, 5000 in dev)
NODE_ENV=production
PORT=5000

# MongoDB Database URI (MongoDB Atlas connection string)
# e.g. mongodb+srv://<username>:<password>@cluster.mongodb.net/vpmart?retryWrites=true&w=majority
MONGODB_URI=

# Frontend Origin URL(s) for CORS & Auth Cookies
# Set to your Netlify site URL (e.g. https://vp-mart.netlify.app)
# For multiple domains or preview deploys, separate with commas:
# CLIENT_ORIGIN=https://vp-mart.netlify.app,https://your-custom-domain.com
CLIENT_ORIGIN=https://vp-mart.netlify.app

# Public Base URL for the Backend (used for serving uploaded assets)
# Set to your Render Web Service URL (e.g. https://vp-mart-backend.onrender.com)
PUBLIC_API_URL=https://vp-mart-backend.onrender.com

# JWT Secret: At least 32 random characters
# On Render: can be automatically generated via Blueprint, or generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=

# Token Lifetimes
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookie Security Settings
# IMPORTANT: When deploying Frontend to Netlify and Backend to Render (cross-site):
# COOKIE_SECURE MUST be true, and COOKIE_SAMESITE MUST be 'none'
# (In local development on localhost: COOKIE_SECURE=false, COOKIE_SAMESITE=lax)
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# COOKIE_DOMAIN=

# Security, Hashing & Rate Limiting
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_PER_MIN=300
STRICT_RATE_LIMIT_PER_HOUR=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Storage Configuration
# 'local' writes to UPLOAD_DIR on Render.
# 's3' stores images on AWS S3 (requires S3_BUCKET, S3_REGION, S3_PUBLIC_BASE_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_PUBLIC_BASE_URL=

# Cache (Redis) - Optional on Render
# If left empty, VP Mart gracefully falls back to MongoDB caching without errors
# REDIS_URL=redis://red-xxxxxxxx:6379

# Email Service
# 'outbox' for development/demo (emails logged to db), 'smtp' for real delivery (SendGrid, Mailgun, Amazon SES, Gmail)
MAIL_TRANSPORT=outbox
MAIL_FROM="VP Mart <no-reply@vpmart.example>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Initial Administrator Seed (used with `npm run seed:admin`)
# ADMIN_EMAIL=admin@vpmart.example
# ADMIN_PASSWORD=ChangeThisStrongPassword123!
# ADMIN_NAME="VP Mart Admin"

# Marketplace Settings
COMMISSION_PERCENT=10
PENDING_PAYMENT_TTL_MIN=30
TAX_MODE=inclusive

# Payment Gateway (Razorpay)
# For real live or test mode transactions:
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxx or rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Enable simulated dummy payment when live keys are not configured:
ENABLE_DUMMY_PAYMENT=true
