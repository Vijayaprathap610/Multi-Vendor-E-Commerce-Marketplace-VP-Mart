# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vpmart?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-value
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Cookies. In production COOKIE_SECURE must be true. Use COOKIE_SAMESITE=none (with Secure)
# only if the API and frontend are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=20
# Requests per minute per IP across the whole API, and public forms (contact, forgot-password) per hour per IP
API_RATE_LIMIT_PER_MIN=300
STRICT_RATE_LIMIT_PER_HOUR=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# outbox = messages are NOT delivered (dev/test). smtp = real delivery.
MAIL_TRANSPORT=outbox
MAIL_FROM="VP Mart <no-reply@your-domain.example>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Used only by `npm run seed:admin`
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=VP Mart Admin
